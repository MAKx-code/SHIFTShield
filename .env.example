# =============================================================
# SHIFTShield 2.0 — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================

# ---- Demo Mode -----------------------------------------------
# Set to "true" to run without Supabase or any external services.
# The app will use built-in fixture data for all features.
# Perfect for local demos and hackathon presentations.
VITE_DEMO_MODE=true

# ---- Backend API ---------------------------------------------
# URL where the FastAPI backend is running.
VITE_API_URL=http://localhost:8000/api

# ---- Supabase (Frontend — use ANON key only) -----------------
# Leave empty if using DEMO_MODE.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# =============================================================
# Backend (.env inside shiftshield/backend/)
# =============================================================

# ---- Demo Mode (Backend) ------------------------------------
DEMO_MODE=true

# ---- Supabase (Backend — SERVICE ROLE key, never in frontend) -
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ---- CORS ---------------------------------------------------
# Comma-separated list of allowed origins
# CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# ---- App ----------------------------------------------------
DEBUG=false
APP_NAME=SHIFTShield 2.0 API
APP_VERSION=1.0.0

# ---- Default location (used for weather if lat/lng not provided) -
DEFAULT_LATITUDE=-33.8688
DEFAULT_LONGITUDE=151.2093
